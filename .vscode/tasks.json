{
    "version": "2.0.0",
    "tasks": [
        {
            // Ctrl+Shift+B: start the local server (if it isn't running
            // yet) and open the homepage in the Windows default browser.
            "label": "Preview site",
            "type": "shell",
            "command": "explorer.exe http://127.0.0.1:4000/ || true",
            "dependsOn": "jekyll serve",
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "jekyll serve",
            "type": "shell",
            "command": "if lsof -ti:4000 -sTCP:LISTEN >/dev/null; then echo 'Server running... (already started)'; else export PATH=\"$HOME/.local/share/gem/ruby/3.2.0/bin:$PATH\"; bundle exec jekyll serve --host 127.0.0.1 --port 4000 --livereload; fi",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^ERROR: (.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\s*Generating\\.\\.\\.",
                    "endsPattern": "^\\s*Server running\\.\\.\\."
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "group": "build"
        }
    ]
}
